<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=f6db14aa1dcf1ae4d87b7a49ed272dae&amp;type=3#MainMenuStyle"/>
    <ui:VisualElement name="Root" class="Root" style="flex-grow: 1; -unity-background-image-tint-color: rgb(0, 0, 0);">
        <ui:VisualElement name="TitleAndButtonsMainDiv" class="TitleAndButtonsMainDiv" style="flex-grow: 1;">
            <ui:VisualElement name="TitleDiv" class="TitleDiv" style="flex-grow: 1;">
                <ui:Label text="Dead Running" name="Title" class="Title" style="-unity-text-generator: advanced; -unity-text-auto-size: none;"/>
            </ui:VisualElement>
            <ui:VisualElement name="AllButtonDiv" class="AllButtonDiv" style="flex-grow: 1;">
                <ui:VisualElement name="PlayButtonDiv" class="ButtonDiv" style="flex-grow: 0; justify-content: center; align-self: center;">
                    <ui:VisualElement name="LineDiv" class="LineDiv" style="flex-grow: 1;">
                        <ui:Image source="project://database/Assets/Art/ButtonLine.png?fileID=2800000&amp;guid=2ec815f17379b2c40b869a2fa7b7659a&amp;type=3#ButtonLine" tint-color="rgb(0, 255, 6)"/>
                    </ui:VisualElement>
                    <ui:Button text="Button" class="Button" style="background-color: rgb(188, 188, 188); -unity-background-image-tint-color: rgb(255, 255, 255);"/>
                </ui:VisualElement>
                <ui:VisualElement name="QuitButtonDiv" class="ButtonDiv" style="flex-grow: 0;">
                    <ui:VisualElement name="LineDiv" class="LineDiv" style="flex-grow: 1;">
                        <ui:Image name="Image" source="project://database/Assets/Art/ButtonLine.png?fileID=2800000&amp;guid=2ec815f17379b2c40b869a2fa7b7659a&amp;type=3#ButtonLine"/>
                    </ui:VisualElement>
                    <ui:Button text="Button" display-tooltip-when-elided="false" class="Button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="AmpuleDiv" class="AmpuleDiv" style="flex-grow: 1;"/>
    </ui:VisualElement>
</ui:UXML>
