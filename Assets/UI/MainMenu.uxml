<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=f6db14aa1dcf1ae4d87b7a49ed272dae&amp;type=3#MainMenuStyle"/>
    <ui:VisualElement name="Root" class="Root" style="flex-grow: 1;">
        <ui:VisualElement name="MainContainer" class="MainContainer" style="flex-grow: 1;">
            <ui:VisualElement name="TitleContainer" style="flex-grow: 1;"/>
            <ui:VisualElement name="ButtonContainer" class="ButtonContainer" style="flex-grow: 0;">
                <ui:VisualElement class="ButtonAImageContainer" style="flex-grow: 0;">
                    <ui:Button text="&#10;" class="Button ButtonImage" style="width: 100%; margin-left: 0; margin-right: 0; align-self: flex-start;"/>
                    <ui:Image source="project://database/Assets/Art/Test.png?fileID=2800000&amp;guid=655ff01bd25df03448840a6925866552&amp;type=3#Test" class="ButtonImage"/>
                </ui:VisualElement>
                <ui:VisualElement class="ButtonAImageContainer" style="flex-grow: 0; height: 110px;">
                    <ui:Button name="Button" class="Button" style="margin-left: 0; margin-right: 0;"/>
                    <ui:Image scale-mode="ScaleToFit" uv="0,0,1,1" source="project://database/Assets/Art/New%20Piskel.png?fileID=2800000&amp;guid=1c77479ab0baafb49bf834b44e206e3e&amp;type=3#New Piskel" style="width: 100%; height: 32px; flex-grow: 0; min-height: 32px;"/>
                </ui:VisualElement>
                <ui:VisualElement class="ButtonAImageContainer" style="flex-grow: 0;">
                    <ui:Button class="Button" style="width: 100%; margin-left: 0; margin-right: 0;"/>
                    <ui:Image source="project://database/Assets/Art/Test.png?fileID=2800000&amp;guid=655ff01bd25df03448840a6925866552&amp;type=3#Test"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
