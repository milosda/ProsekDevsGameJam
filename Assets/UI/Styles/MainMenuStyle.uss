:root {
}

.Root {
    flex-direction: row;
}

.TitleAndButtonsMainDiv {
    width: 40%;
}

.AmpuleDiv {
    width: 60%;
}

.TitleDiv {
    height: 40%;
    justify-content: center;
    align-items: center;
    align-self: flex-start;
    margin-left: 20px;
}

.AllButtonDiv {
    align-items: center;
    height: 60%;
    justify-content: center;
}

.ButtonDiv {
    height: auto;
    min-height: auto;
    margin-right: 40%;
    flex-direction: row;
}

.Button {
    margin-right: 0;
    height: 32px;
}

.LineDiv {
    align-self: center;
    min-width: 1px;
    max-width: 32px;
    position: absolute;
    left: -20px;
}

.Title {
    font-size: 28px;
    color: rgb(33, 87, 32);
}
