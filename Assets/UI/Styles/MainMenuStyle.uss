:root {
}

.Root {
    flex-direction: row;
}

.TitleAndButtonsMainDiv {
    width: 40%;
}

.AmpuleDiv {
    width: 60%;
}

.TitleDiv {
    height: 40%;
    justify-content: center;
    align-items: center;
    align-self: flex-start;
    margin-left: 20px;
}

.AllButtonDiv {
    align-items: center;
    height: 60%;
    justify-content: center;
}

.ButtonDiv {
    height: auto;
    min-height: 32px;
    margin-right: 40%;
    flex-direction: row;
}

.Button {
    margin-right: 0;
    height: 32px;
    visibility: visible;
    display: flex;
    opacity: 0;
    position: relative;
    max-height: 32px;
    min-height: 32px;
    width: auto;
    min-width: auto;
    max-width: none;
}

.LineDiv {
    align-self: center;
    min-width: 1px;
    max-width: 32px;
    position: absolute;
    left: -15px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 0;
    border-right-color: rgb(0, 0, 0);
    border-right-width: 0;
    border-left-color: rgb(255, 255, 255);
    border-left-width: 2px;
    width: 1px;
    margin-left: 10px;
    min-height: 32px;
    height: 32px;
}

.Title {
    font-size: 28px;
    color: rgb(194, 229, 130);
    -unity-font-definition: url("project://database/Assets/Fonts/PixelatedEleganceRegular-ovawB.ttf?fileID=12800000&guid=3d25019246d00f1409d9a6661339f55c&type=3#PixelatedEleganceRegular-ovawB");
}

.DivInButtonDiv {
    min-height: 32px;
    align-items: flex-start;
    justify-content: center;
}

.ButtonText {
    position: absolute;
    min-width: 32px;
    min-height: 32px;
    -unity-text-align: middle-left;
    color: rgb(194, 229, 130);
    -unity-font-definition: url("project://database/Assets/Fonts/PixelatedEleganceRegular-ovawB.ttf?fileID=12800000&guid=3d25019246d00f1409d9a6661339f55c&type=3#PixelatedEleganceRegular-ovawB");
    margin-left: 0%;
    padding-left: 0%;
    left: 15%;
}
