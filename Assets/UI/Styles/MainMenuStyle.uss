.Root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    align-self: center;
}

.MainContainer {
    width: 50%;
}

.ButtonContainer {
    justify-content: center;
    margin-bottom: 0;
    height: 80%;
    width: 100%;
    align-self: center;
    align-content: auto;
    align-items: stretch;
}

.Button {
    margin-bottom: 0;
    margin-top: 0;
    width: 100%;
    height: 10%;
    min-width: 32px;
    min-height: 32px;
    align-self: center;
    position: absolute;
}

.ButtonImage {
    position: absolute;
    width: 100%;
}

.ButtonAImageContainer {
    position: relative;
    align-items: center;
    justify-content: center;
    align-self: auto;
    height: 10%;
    min-height: 32px;
}
